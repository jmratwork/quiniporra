# ---------------------------------------------------------------------------
# quiniporra — variables de entorno
# Copia este fichero a .env y rellena los valores.
# ---------------------------------------------------------------------------

# Cadena de conexión a PostgreSQL.
# Compatible con Vercel Postgres, Neon o Supabase.
# Ejemplo local:   postgresql://postgres:postgres@localhost:5432/quiniporra?schema=public
# Ejemplo Neon:    postgresql://usuario:password@ep-xxx.eu-central-1.aws.neon.tech/quiniporra?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiniporra?schema=public"

# PIN del panel de administración.
# En producción es OBLIGATORIO y debe tener al menos 12 caracteres.
ADMIN_PIN="cambia-este-pin-largo"

# Secreto para firmar los tokens de invitación (HMAC).
# En producción es OBLIGATORIO. Usa una cadena aleatoria larga, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITACION_SECRET="cambia-este-secreto-aleatorio-largo"
